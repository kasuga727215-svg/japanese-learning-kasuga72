MANUAL_GENERATE_TIMEOUT_SECONDS=20
MANUAL_GENERATE_FRONTEND_TIMEOUT_SECONDS=25
GEMINI_GENERATE_TIMEOUT_SECONDS=50
GEMINI_STAGE_TIMEOUT_SECONDS=18
GEMINI_BANK_MIN_WORD_PER_LEVEL=20
GEMINI_BANK_MIN_VERB_PER_LEVEL=15
GEMINI_BANK_MIN_GRAMMAR_PER_LEVEL=10
GEMINI_BANK_TARGET_WORD_PER_LEVEL=50
GEMINI_BANK_TARGET_VERB_PER_LEVEL=30
GEMINI_BANK_TARGET_GRAMMAR_PER_LEVEL=15
GEMINI_BANK_TARGET_SNS=20
GEMINI_BANK_MAX_REFILL_ATTEMPTS_PER_POOL=20
GEMINI_BANK_ALLOW_RECENT_REUSE=false
GEMINI_BANK_REFILL_BATCH_SIZE=3
GEMINI_BANK_STAGE_TIMEOUT_SECONDS=15
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REMINDER_SECRET=

# Daily cron is disabled in code; materials are generated manually only.
# MANUAL_GENERATE_TIMEOUT_SECONDS limits backend manual local generation time.
# MANUAL_GENERATE_FRONTEND_TIMEOUT_SECONDS limits frontend waiting time for manual generation.
# GEMINI_GENERATE_TIMEOUT_SECONDS limits backend Gemini daily material generation time; values above 55 are capped.
# GEMINI_STAGE_TIMEOUT_SECONDS limits each staged Gemini batch request; values above 25 are capped.
# GEMINI_BANK_* controls item-bank refill buffers; each stage refills one item type and one JLPT level only.
# TELEGRAM_REMINDER_SECRET protects /api/telegram/reminder-run for Google Apps Script pings.
